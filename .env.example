# ============================================
# SERVER
# ============================================
SERVER_PORT=8080                    # default: 8080
SERVER_ENVIRONMENT=development       # default: development
SERVER_READ_TIMEOUT=30s             # default: 30s
SERVER_WRITE_TIMEOUT=30s            # default: 30s

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_HOST=localhost             # default: localhost
DATABASE_PORT=5432                  # default: 5432
DATABASE_USER=postgres              # default: postgres
DATABASE_PASSWORD=                  # default: "" (REQUIRED for production)
DATABASE_DBNAME=kipa                # default: kipa
DATABASE_SSLMODE=disable            # default: disable (use "require" for production)
DATABASE_MAX_OPEN_CONNS=25          # default: 25
DATABASE_MAX_IDLE_CONNS=5           # default: 5
DATABASE_CONN_MAX_LIFETIME=5m       # default: 5m

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost                # default: localhost
REDIS_PORT=6379                     # default: 6379
REDIS_PASSWORD=                     # default: "" (REQUIRED if Redis has auth)
REDIS_DB=0                          # default: 0
REDIS_POOL_SIZE=10                  # default: 10
REDIS_MIN_IDLE_CONNS=2              # default: 2

# ============================================
# JWT (REQUIRED - no defaults)
# ============================================
JWT_ACCESS_SECRET=                  # REQUIRED - Generate a secure random string
JWT_REFRESH_SECRET=                 # REQUIRED - Generate a secure random string
JWT_ACCESS_TOKEN_EXPIRY=15m         # default: 15m
JWT_REFRESH_TOKEN_EXPIRY=168h       # default: 168h (7 days)
JWT_ISSUER=kipa                     # default: kipa

# ============================================
# OTP
# ============================================
OTP_LENGTH=6                        # default: 6
OTP_EXPIRY_DURATION=5m              # default: 5m
OTP_MAX_ATTEMPTS=3                  # default: 3
OTP_RATE_LIMIT_COUNT=5              # default: 5
OTP_RATE_LIMIT_WINDOW=1h            # default: 1h
OTP_BCRYPT_COST=10                  # default: 10

# ============================================
# Termii (for SMS via SNS) - REQUIRED
# ============================================
TERMII_API_KEY=                     # REQUIRED - from Termii dashboard
TERMII_SENDER_ID=Kipa              # default: Kipa
TERMII_ENABLE_VOICE_FALLBACK=true  # default: true

# ============================================
# PAYSTACK - REQUIRED
# ============================================
PAYSTACK_BASE_URL=https://api.paystack.co  # default
PAYSTACK_SECRET_KEY=                # REQUIRED - Your Paystack secret key
PAYSTACK_PUBLIC_KEY=                # REQUIRED - Your Paystack public key

# ============================================
# WORKERS
# ============================================
WORKER_ENABLED=true
WORKER_ESCROW_CHECK_INTERVAL=1m
WORKER_RIDER_SEARCH_CHECK_INTERVAL=30s
WORKER_LINK_EXPIRY_CHECK_INTERVAL=5m
WORKER_RADIUS_EXPAND_INTERVAL=2m
WORKER_RIDER_SEARCH_TIMEOUT_MINS=15
WORKER_RADIUS_EXPAND_INTERVAL_MINS=3

# ============================================
# GOOGLE MAPS
# ============================================
GOOGLE_MAPS_API_KEY=                # REQUIRED - Your Google Maps API key

# ============================================
# AWS
# ============================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=kipa-uploads
AWS_ACCESS_KEY_ID=                  # REQUIRED - Your AWS access key
AWS_SECRET_ACCESS_KEY=              # REQUIRED - Your AWS secret key
AWS_S3_BASE_URL=https://kipa-uploads.s3.amazonaws.com
AWS_MAX_FILE_SIZE_MB=5
