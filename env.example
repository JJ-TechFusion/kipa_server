# Kipa API Environment Variables
# Copy this file to .env and update the values

# Server Configuration
SERVER_PORT=8080
SERVER_ENVIRONMENT=development

# Database Configuration (Docker will override these)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=kipa
DATABASE_SSLMODE=disable

# Redis Configuration (Docker will override these)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-here-make-it-long-and-random
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-here-make-it-different
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ISSUER=kipa

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_DURATION=5m
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_COUNT=5
OTP_RATE_LIMIT_WINDOW=1h
OTP_BCRYPT_COST=10

# Twilio Configuration (for SMS verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE_NUMBER=your_twilio_phone_number

# Paystack Configuration (for payments) - REQUIRED FOR PAYMENT FEATURES
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_BASE_URL=https://api.paystack.co

# Google Maps Configuration (for location services)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# AWS S3 Configuration (for file uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-kipa-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BASE_URL=https://your-kipa-bucket.s3.amazonaws.com
AWS_MAX_FILE_SIZE_MB=10

# Firebase Configuration (for push notifications)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Worker Configuration
WORKER_ENABLED=true
WORKER_ESCROW_CHECK_INTERVAL=1m
WORKER_RIDER_SEARCH_CHECK_INTERVAL=30s
WORKER_LINK_EXPIRY_CHECK_INTERVAL=5m
WORKER_RADIUS_EXPAND_INTERVAL=2m
WORKER_TIMER_EXPIRY_CHECK_INTERVAL=1m
WORKER_RIDER_SEARCH_TIMEOUT_MINS=15
WORKER_RADIUS_EXPAND_STEPS=3,5,8,12
WORKER_RADIUS_EXPAND_INTERVAL_MINS=3
WORKER_RIDER_OFFER_TIMEOUT_MINS=2
WORKER_MAX_JOB_RESTARTS=10
WORKER_INITIAL_BACKOFF=1s
WORKER_MAX_BACKOFF=60s
WORKER_JITTER_PERCENT=10
WORKER_REMINDER_COOLDOWN_MINS=60